vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

# 1. Styles & Klassen definieren
classes: {
  # Kabel
  kabel_standard: { style: { stroke: "#000000"; stroke-width: 3 } }
  kabel_orange: { style: { stroke: "#e67e22"; stroke-width: 3 } }
  
  # Bauteile
  widerstand: { shape: parallelogram; style.fill: "#9b59b6" }
  jumper: { shape: parallelogram; style.fill: "#f1c40f" }
  pin: {
    shape: rectangle
    width: 80
    height: 40
    style: { font-size: 14 }
  }

  # Geräte-Kategorien
  core_component: {
    shape: package
    style: { stroke: "#ff0000"; stroke-width: 4 } # Roter Rahmen
  }
  complex_device: {
    shape: package
    style: { stroke: "#0000ff"; stroke-width: 3 } # Blauer Rahmen
  }
  end_device: {
    shape: package
    style: { stroke: "#000000"; stroke-width: 2 } # Schwarzer Rahmen
  }
}

# --- KOMPONENTEN ---

# Ruida Controller
Ruida_644: {
  class: core_component
  label: "Ruida RDC644G/S"

  CN1: {
    "1: GND": { class: pin }; "2: OUT2": { class: pin }; "3: OUT1": { class: pin }
    "4: STATUS": { class: pin }; "5: WIND": { class: pin }; "6: +24V": { class: pin }
  }
  CN2: {
    "1: GND": { class: pin }; "2: FOOTSW": { class: pin }; "3: DRPROC": { class: pin }
    "4: SHOT": { class: pin }; "5: IN1": { class: pin }; "6: +24V": { class: pin }
  }
  CN3: {
    "1: GND": { class: pin }; "2: LMTU-": { class: pin }; "3: LMTU+": { class: pin }
    "4: LMTZ-": { class: pin }; "5: LMTZ+": { class: pin }; "6: +5V": { class: pin }
  }
  CN4: {
    "1: GND": { class: pin }; "2: LMTY-": { class: pin }; "3: LMTY+": { class: pin }
    "4: LMTX-": { class: pin }; "5: LMTX+": { class: pin }; "6: +5V": { class: pin }
  }
  AXISX: {
    "1: DIR_X": { class: pin }; "2: PUL_X": { class: pin }; "3: +5V_X": { class: pin }
  }
  AXISY: {
    "1: DIR_Y": { class: pin }; "2: PUL_Y": { class: pin }; "3: +5V_Y": { class: pin }
  }
  CN5: {
    "1: GND": { class: pin }; "2: L-ON1": { class: pin }; "3: LPWM1": { class: pin }
    "4: WP1": { class: pin }; "5: L-AN1": { class: pin }
  }
}

# Motor Treiber
DM860T_X: {
  class: complex_device
  label: "DM860T (X)"
  P1: {
    label: "P1: Control"
    "PUL+": { class: pin }; "PUL-": { class: pin }
    "DIR+": { class: pin }; "DIR-": { class: pin }
    "ENA+": { class: pin }; "ENA-": { class: pin }
  }
  P3: {
    label: "P3: Motor/Power"
    "A+": { class: pin }; "A-": { class: pin }
    "B+": { class: pin }; "B-": { class: pin }
    "AC_1": { class: pin; label: "AC" }
    "AC_2": { class: pin; label: "AC" }
  }
}

DM860T_Y: {
  class: complex_device
  label: "DM860T (Y)"
  P1: {
    label: "P1: Control"
    "PUL+": { class: pin }; "PUL-": { class: pin }
    "DIR+": { class: pin }; "DIR-": { class: pin }
  }
  P3: {
    label: "P3: Motor/Power"
    "A+": { class: pin }; "A-": { class: pin }
    "B+": { class: pin }; "B-": { class: pin }
    "AC_1": { class: pin; label: "AC" }
    "AC_2": { class: pin; label: "AC" }
  }
}

# Schrittmotoren
Stepper_X: {
  class: end_device
  label: "X-Stepper: ST4118M1206-A"
  "A+": { class: pin }; "A-": { class: pin }
  "B+": { class: pin }; "B-": { class: pin }
}

Stepper_Y: {
  class: end_device
  label: "Y-Stepper: PKP266D28A2"
  "A+": { class: pin }; "A-": { class: pin }
  "B+": { class: pin }; "B-": { class: pin }
}

# Laser PSU
Laser_PSU: {
  shape: package
  "5V": { class: pin }
  IN: { class: pin }
  TL: { class: pin }
  WP: { class: pin }
  TH: { class: pin }
  GND: { class: pin }
}

# Passive Bauteile
Bruecke_Laser_IN_5V: 0R { class: jumper }
Resistor_10k_Laser_IN_WP: 10k { class: widerstand }
Resistor_10k_Laser_TH_GND: 10k { class: widerstand }

# --- VERBINDUNGEN ---

# X-Achse (Common Anode)
Ruida_644.AXISX."3: +5V_X" -> DM860T_X.P1."PUL+": "5V Com" {class: kabel_standard}
Ruida_644.AXISX."3: +5V_X" -> DM860T_X.P1."DIR+": "5V Com" {class: kabel_standard}
Ruida_644.AXISX."2: PUL_X" -> DM860T_X.P1."PUL-": "Pulse" {class: kabel_standard}
Ruida_644.AXISX."1: DIR_X" -> DM860T_X.P1."DIR-": "Dir" {class: kabel_standard}

DM860T_X.P3."A+" -> Stepper_X."A+" {class: kabel_standard}
DM860T_X.P3."A-" -> Stepper_X."A-" {class: kabel_standard}
DM860T_X.P3."B+" -> Stepper_X."B+" {class: kabel_standard}
DM860T_X.P3."B-" -> Stepper_X."B-" {class: kabel_standard}

# Y-Achse (Common Anode)
Ruida_644.AXISY."3: +5V_Y" -> DM860T_Y.P1."PUL+": "5V Com" {class: kabel_standard}
Ruida_644.AXISY."3: +5V_Y" -> DM860T_Y.P1."DIR+": "5V Com" {class: kabel_standard}
Ruida_644.AXISY."2: PUL_Y" -> DM860T_Y.P1."PUL-": "Pulse" {class: kabel_standard}
Ruida_644.AXISY."1: DIR_Y" -> DM860T_Y.P1."DIR-": "Dir" {class: kabel_standard}

DM860T_Y.P3."A+" -> Stepper_Y."A+" {class: kabel_standard}
DM860T_Y.P3."A-" -> Stepper_Y."A-" {class: kabel_standard}
DM860T_Y.P3."B+" -> Stepper_Y."B+" {class: kabel_standard}
DM860T_Y.P3."B-" -> Stepper_Y."B-" {class: kabel_standard}

# Laser Steuerung & Beschaltung
Ruida_644.CN5.GND -> Laser_PSU.GND: "GND" {class: kabel_standard}
Ruida_644.CN5.L-ON1 -> Laser_PSU.TL: "Fire" {class: kabel_standard}
Ruida_644.CN5.LPWM1 -> Laser_PSU.IN: "PWM" {class: kabel_standard}

Laser_PSU.IN -- Resistor_10k_Laser_IN_WP { class: kabel_standard }
Laser_PSU.WP -- Resistor_10k_Laser_IN_WP { class: kabel_standard }
Laser_PSU.TH -- Resistor_10k_Laser_TH_GND { class: kabel_standard }
Laser_PSU.GND -- Resistor_10k_Laser_TH_GND { class: kabel_standard }
Laser_PSU.IN -- Bruecke_Laser_IN_5V { class: kabel_standard }
Laser_PSU.5V -- Bruecke_Laser_IN_5V { class: kabel_standard }
