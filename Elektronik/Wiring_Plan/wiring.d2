DOOR1.class: end_device
DOOR1.label: "Türschalter 1"
DOOR1.COM.class: pin
DOOR1.NO.class: pin

DOOR2.class: end_device
DOOR2.label: "Türschalter 2"
DOOR2.COM.class: pin
DOOR2.NO.class: pin

DOOR3.class: end_device
DOOR3.label: "Türschalter 3"
DOOR3.COM.class: pin
DOOR3.NC.class: pin

DOOR4.class: end_device
DOOR4.label: "Türschalter 4"
DOOR4.COM.class: pin
DOOR4.NC.class: pin

# --- WATER FLOW RELAIS (Signal-Ebene) ---
# Hinweis: Dies ist zusätzlich zum bestehenden Flow_Relais im AC-Kreis
Water_Flow_Relais.class: end_device
Water_Flow_Relais.label: "Water Flow Relais"
Water_Flow_Relais.Terminals.class: connector_group
Water_Flow_Relais.Terminals.COM1.class: pin
Water_Flow_Relais.Terminals.NO1.class: pin
Water_Flow_Relais.Terminals.NC1.class: pin
Water_Flow_Relais.Terminals.COM2.class: pin
Water_Flow_Relais.Terminals.NO2.class: pin
Water_Flow_Relais.Terminals.NC2.class: pin
Water_Flow_Relais.Terminals.COIL1.class: pin
Water_Flow_Relais.Terminals.COIL2.class: pin

# --- CHILLER ALARM ---
Chiller_Alarm.class: end_device
Chiller_Alarm.label: "Chiller Alarm Eingang"
Chiller_Alarm.Terminals.class: connector_group
Chiller_Alarm.Terminals.COM.class: pin
Chiller_Alarm.Terminals.NC.class: pin

# --- WARNLEUCHTE ---
Warnleuchte.class: end_device
Warnleuchte.label: "Warnleuchte"
Warnleuchte.AC1.class: pin
Warnleuchte.AC2.class: pin

# --- VERBINDUNGEN ---

# X-Axis wiring
Ruida_644.AXISX."3: +5V_X" -> DM860T_X.P1."PUL+": "5V Com" {class: kabel_standard}
Ruida_644.AXISX."3: +5V_X" -> DM860T_X.P1."DIR+": "5V Com" {class: kabel_standard}
Ruida_644.AXISX."2: PUL_X" -> DM860T_X.P1."PUL-": "Pulse" {class: kabel_standard}
Ruida_644.AXISX."1: DIR_X" -> DM860T_X.P1."DIR-": "Dir" {class: kabel_standard}

DM860T_X.P3."A+" -> Stepper_X."A+" {class: kabel_standard}
DM860T_X.P3."A-" -> Stepper_X."A-" {class: kabel_standard}
DM860T_X.P3."B+" -> Stepper_X."B+" {class: kabel_standard}
DM860T_X.P3."B-" -> Stepper_X."B-" {class: kabel_standard}

# Y-Axis wiring
Ruida_644.AXISY."3: +5V_Y" -> DM860T_Y.P1."PUL+": "5V Com" {class: kabel_standard}
Ruida_644.AXISY."3: +5V_Y" -> DM860T_Y.P1."DIR+": "5V Com" {class: kabel_standard}
Ruida_644.AXISY."2: PUL_Y" -> DM860T_Y.P1."PUL-": "Pulse" {class: kabel_standard}
Ruida_644.AXISY."1: DIR_Y" -> DM860T_Y.P1."DIR-": "Dir" {class: kabel_standard}

DM860T_Y.P3."A+" -> Stepper_Y."A+" {class: kabel_standard}
DM860T_Y.P3."A-" -> Stepper_Y."A-" {class: kabel_standard}
DM860T_Y.P3."B+" -> Stepper_Y."B+" {class: kabel_standard}
DM860T_Y.P3."B-" -> Stepper_Y."B-" {class: kabel_standard}

# Laser wiring
Ruida_644.CN5.GND -> Laser_PSU.Terminals.GND: "GND" {class: kabel_standard}
Ruida_644.CN5.LON1 -> Laser_PSU.Terminals.TL: "Fire" {class: kabel_standard}
Ruida_644.CN5.LPWM1 -> Laser_PSU.Terminals.IN: "PWM" {class: kabel_standard}

# --- STROMVERBINDUNGEN ---

# Ruida 24V Versorgung über Port CN1 
PSU_24V.Terminals."24V" -> Ruida_644.CN1."6: +24V": "24V DC" {class: kabel_standard}
PSU_24V.Terminals."0V" -> Ruida_644.CN1."1: GND": "GND" {class: kabel_standard}

# Phase L2 speist den gemeinsamen Kontakt
Supply_2.Terminals.L2 -> LV_Relais.Terminals.COM1: "Phase L2" {class: kabel_standard}

# Der Schließerkontakt (NO) versorgt beide Netzteile
LV_Relais.Terminals.NO1 -> PSU_48V.Terminals.L: "Switched L2" {class: kabel_standard}
LV_Relais.Terminals.NO1 -> PSU_24V.Terminals.L: "Switched L2" {class: kabel_standard}

# --- VERBINDUNGEN NEUTRALLEITER ---
Supply_2.Terminals.N2 -> LV_Relais.Terminals.COM2: "Neutral N2" {class: kabel_standard}
LV_Relais.Terminals.NO2 -> PSU_48V.Terminals.N: "Switched N2" {class: kabel_standard}
LV_Relais.Terminals.NO2 -> PSU_24V.Terminals.N: "Switched N2" {class: kabel_standard}

# Motortreiber 48V Versorgung (X-Achse) [cite: 18, 20]
PSU_48V.Terminals."+48V" -> DM860T_X.P3.AC1 {class: kabel_standard}
PSU_48V.Terminals."0V" -> DM860T_X.P3.AC2 {class: kabel_standard}

# Motortreiber 48V Versorgung (Y-Achse) [cite: 21, 23]
PSU_48V.Terminals."+48V" -> DM860T_Y.P3.AC1 {class: kabel_standard}
PSU_48V.Terminals."0V" -> DM860T_Y.P3.AC2 {class: kabel_standard}

# --- VERBINDUNGEN SCHLÜSSELSCHALTER ---
Supply_1.Terminals.L1 -> Key_Switch.Terminals.IN1: "Phase L1" {class: kabel_standard}
Supply_1.Terminals.N1 -> Key_Switch.Terminals.IN2: "Neutral N1" {class: kabel_standard}

# Verbindung COM1 an OUT vom Schlüsselschalter
Key_Switch.Terminals.OUT1 -> Flow_Relais.Terminals.COM1: "Switched L1" {class: kabel_standard}
Key_Switch.Terminals.OUT2 -> Flow_Relais.Terminals.COM2: "Switched N2" {class: kabel_standard}

# --- VERBINDUNGEN DURCHFLUSS RELAIS ZU EIN/AUSSCHALTER ---

# Phase L1 (Kanal 1)
Flow_Relais.Terminals.NO1 -> Power_Switch.Terminals.IN: "Switched L1" {class: kabel_standard}

# Dann vom Durchfluss-Relais zum Ein-/Ausschalter
Flow_Relais.Terminals.NO2 -> Power_Switch.Terminals.N_IN: "Switched N2" {class: kabel_standard}

# --- VERBINDUNGEN E-STOP (SIGNAL) ---

# Kanal 1: Überwachung durch Ruida (DRPROC zu GND)
Ruida_644.CN2."3: DRPROC" -> E_Stop.Terminals.COM1: "Protection Signal" {class: kabel_standard}

# E-Stop NC1 führt nun weiter zu Türschalter 3 
E_Stop.Terminals.NC1 -> DOOR3.COM {class: kabel_standard}

# Türschalter 3 (NC) führt zu Türschalter 4 
DOOR3.NC -> DOOR4.COM {class: kabel_standard}

# Türschalter 4 (NC) schließt den Kreis nach GND 
DOOR4.NC -> Ruida_644.CN2."1: GND": "GND" {class: kabel_standard}
# --- VERBINDUNGEN LASER PROTECTION LOOP (WP) ---

# Start der Kette: Laser Netzteil WP an Türschalter 1
Laser_PSU.Terminals.WP -> DOOR1.COM: "WP Loop" {class: kabel_standard}

# Türschalter 1 an Türschalter 2
DOOR1.NO -> DOOR2.COM {class: kabel_standard}

# Türschalter 2 an Durchfluss-Relais (Signal-Ebene)
DOOR2.NO -> Water_Flow_Relais.Terminals.COM1 {class: kabel_standard}

# Durchfluss-Relais an Chiller Alarm
Water_Flow_Relais.Terminals.NO1 -> Chiller_Alarm.Terminals.COM {class: kabel_standard}

# Chiller Alarm an Laser Ground (Abschluss der Sicherheitskette)
Chiller_Alarm.Terminals.NC -> Laser_PSU.Terminals.GND: "GND" {class: kabel_standard}

# --- VERBINDUNGEN RUIDA WATER PROTECTION (Signal-Ebene) ---

# Versorgung des Relais-Kontakts mit 24V vom Netzteil
PSU_24V.Terminals."24V" -> Water_Flow_Relais.Terminals.COM2: "24V Signal" {class: kabel_standard}

# Signalweiterleitung vom Relais zum Ruida WP-Eingang (Port CN2, Pin 5)
Water_Flow_Relais.Terminals.NC2 -> Ruida_644.CN2."5: WP1": "Water Protection" {class: kabel_standard}

# --- Pull Widerstände ---

WP_10k.A -> Ruida_644.CN2."5: WP1": "Pull-Down" {class: kabel_standard}
WP_10k.B -> Ruida_644.CN2."1: GND": "GND" {class: kabel_standard}

# Vom Ein-/Ausschalter zum Laser Switch
Power_Switch.Terminals.OUT -> Laser_Switch.Terminals.COM1: "L1 geschaltet" {class: kabel_standard}
Power_Switch.Terminals.N_OUT -> Laser_Switch.Terminals.COM2: "N1 geschaltet" {class: kabel_standard}

# Vom Laser Switch zur Warnleuchte
Laser_Switch.Terminals.NO1 -> Warnleuchte.AC1 {class: kabel_standard}
Laser_Switch.Terminals.NO2 -> Warnleuchte.AC2 {class: kabel_standard}

# Vom Laser Switch zur Laser PSU (AC-Versorgung)
Laser_Switch.Terminals.NO1 -> Laser_PSU.Terminals.AC1: "L1 Laser" {class: kabel_standard}
Laser_Switch.Terminals.NO2 -> Laser_PSU.Terminals.AC2: "N1 Laser" {class: kabel_standard}

# --- VERBINDUNGEN PULL-UP ---
# Pin A wird mit dem Wasserschutz-Eingang (WP) verbunden
Laser_Pullup_10k.A -> Laser_PSU.Terminals.WP: "Pull-Up" {class: kabel_standard}

# Pin B wird mit dem 5V Ausgang der Laser PSU verbunden
Laser_Pullup_10k.B -> Laser_PSU.Terminals.V5: "5V" {class: kabel_standard}
Laser_Pullup_10k.B -> Laser_PSU.Terminals.IN: "Pull-Up" {class: kabel_standard}

# Verbindungen
# Pin A an den TH-Eingang (Trigger High)
Laser_TH_Pulldown_10k.A -> Laser_PSU.Terminals.TH: "Pull-Down" {class: kabel_standard}

# Pin B an Ground
Laser_TH_Pulldown_10k.B -> Laser_PSU.Terminals.GND: "GND" {class: kabel_standard}