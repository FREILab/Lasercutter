PSU_24V.Terminals.class: connector_group
PSU_24V.Terminals.L.class: pin
PSU_24V.Terminals.N.class: pin
PSU_24V.Terminals."24V".class: pin
PSU_24V.Terminals."0V".class: pin

# --- NOT-HALT (E-Stop) ---
E_Stop.class: end_device
E_Stop.label: "Not-Halt (E-Stop)"
E_Stop.Terminals.class: connector_group
E_Stop.Terminals.COM1.class: pin
E_Stop.Terminals.NC1.class: pin
E_Stop.Terminals.COM2.class: pin
E_Stop.Terminals.NC2.class: pin

