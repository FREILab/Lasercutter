vars: {
  d2-config: {
    layout-engine: dagre
    #layout-engine: elk
  }
}

direction: right

# Globaler Hintergrund
style.fill: "#f4f4f9"

# 1. Styles & Klassen
classes: {
  kabel_standard: { style.stroke: "#000000"; style.stroke-width: 3 }
  
  pin: {
    shape: rectangle
    width: 80
    height: 40
    style: { font-size: 14; fill: "#ffffff" }
  }

  connector_group: {
    shape: rectangle
    style: { 
      stroke: "#7f8c8d"
      stroke-width: 1
      stroke-dash: 5 
      fill: transparent 
    }
  }

  core_component: {
    shape: rectangle
    style: { stroke: "#ff0000"; stroke-width: 4; fill: "#fff2f2" }
  }
  
  complex_device: {
    shape: rectangle
    style: { stroke: "#0000ff"; stroke-width: 3; fill: "#f2f7ff" }
  }

  end_device: {
    shape: rectangle
    style: { stroke: "#000000"; stroke-width: 2; fill: "#ffffff" }
  }
}

# --- RUIDA CONTROLLER ---
Ruida_644: { class: core_component; label: "Ruida RDC644G/S" }

# Port CN1: General Output
Ruida_644.CN1: { class: connector_group; label: "CN1: Output" }
Ruida_644.CN1."1: GND": { class: pin }
Ruida_644.CN1."2: OUT2": { class: pin }
Ruida_644.CN1."3: OUT1": { class: pin }
Ruida_644.CN1."4: STATUS": { class: pin }
Ruida_644.CN1."5: WIND": { class: pin }
Ruida_644.CN1."6: +24V": { class: pin }

# Port CN2: General Input
Ruida_644.CN2: { class: connector_group; label: "CN2: Input" }
Ruida_644.CN2."1: GND": { class: pin }
Ruida_644.CN2."2: FOOTSW": { class: pin }
Ruida_644.CN2."3: DRPROC": { class: pin }
Ruida_644.CN2."4: SHOT": { class: pin }
Ruida_644.CN2."5: IN1": { class: pin }
Ruida_644.CN2."6: +24V": { class: pin }

# Port CN3: Limit U/Z
Ruida_644.CN3: { class: connector_group; label: "CN3: Limits U/Z" }
Ruida_644.CN3."1: GND": { class: pin }
Ruida_644.CN3."2: LMTU-": { class: pin }
Ruida_644.CN3."3: LMTU+": { class: pin }
Ruida_644.CN3."4: LMTZ-": { class: pin }
Ruida_644.CN3."5: LMTZ+": { class: pin }
Ruida_644.CN3."6: +5V": { class: pin }

# Port CN4: Limit X/Y
Ruida_644.CN4: { class: connector_group; label: "CN4: Limits X/Y" }
Ruida_644.CN4."1: GND": { class: pin }
Ruida_644.CN4."2: LMTY-": { class: pin }
Ruida_644.CN4."3: LMTY+": { class: pin }
Ruida_644.CN4."4: LMTX-": { class: pin }
Ruida_644.CN4."5: LMTX+": { class: pin }
Ruida_644.CN4."6: +5V": { class: pin }

# Achsen-Schnittstellen (X, Y, Z, U)
Ruida_644.AXISX: { class: connector_group; label: "AXIS X" }
Ruida_644.AXISX."1: DIR_X": { class: pin }
Ruida_644.AXISX."2: PUL_X": { class: pin }
Ruida_644.AXISX."3: +5V_X": { class: pin }

Ruida_644.AXISY: { class: connector_group; label: "AXIS Y" }
Ruida_644.AXISY."1: DIR_Y": { class: pin }
Ruida_644.AXISY."2: PUL_Y": { class: pin }
Ruida_644.AXISY."3: +5V_Y": { class: pin }

Ruida_644.AXISZ: { class: connector_group; label: "AXIS Z" }
Ruida_644.AXISZ."1: DIR_Z": { class: pin }
Ruida_644.AXISZ."2: PUL_Z": { class: pin }
Ruida_644.AXISZ."3: +5V_Z": { class: pin }

Ruida_644.AXISU: { class: connector_group; label: "AXIS U" }
Ruida_644.AXISU."1: DIR_U": { class: pin }
Ruida_644.AXISU."2: PUL_U": { class: pin }
Ruida_644.AXISU."3: +5V_U": { class: pin }

# Laser-Steuerung CN5/CN6
Ruida_644.CN5: { class: connector_group; label: "CN5: Laser 1" }
Ruida_644.CN5."1: GND": { class: pin }
Ruida_644.CN5."2: L-ON1": { class: pin }
Ruida_644.CN5."3: LPWM1": { class: pin }
Ruida_644.CN5."4: WP1": { class: pin }
Ruida_644.CN5."5: L-AN1": { class: pin }

Ruida_644.CN6: { class: connector_group; label: "CN6: Laser 2" }
Ruida_644.CN6."1: GND": { class: pin }
Ruida_644.CN6."2: L-ON2": { class: pin }
Ruida_644.CN6."3: LPWM2": { class: pin }
Ruida_644.CN6."4: WP2": { class: pin }
Ruida_644.CN6."5: L-AN2": { class: pin }

# --- MOTORTREIBER X ---
DM860T_X: { class: complex_device; label: "DM860T (X)" }
DM860T_X.P1: { class: connector_group; label: "P1: Control" }
DM860T_X.P1."PUL+": { class: pin }
DM860T_X.P1."PUL-": { class: pin }
DM860T_X.P1."DIR+": { class: pin }
DM860T_X.P1."DIR-": { class: pin }
DM860T_X.P1."ENA+": { class: pin }
DM860T_X.P1."ENA-": { class: pin }

DM860T_X.P2: { class: connector_group; label: "P2: Fault Output" }
DM860T_X.P2."BRK+": { class: pin }
DM860T_X.P2."BRK-": { class: pin }
DM860T_X.P2."ALM+": { class: pin }
DM860T_X.P2."ALM-": { class: pin }

DM860T_X.P3: { class: connector_group; label: "P3: Power/Motor" }
DM860T_X.P3."A+": { class: pin }
DM860T_X.P3."A-": { class: pin }
DM860T_X.P3."B+": { class: pin }
DM860T_X.P3."B-": { class: pin }
DM860T_X.P3."AC1": { class: pin }
DM860T_X.P3."AC2": { class: pin }

# --- MOTORTREIBER Y ---
DM860T_Y: { class: complex_device; label: "DM860T (Y)" }
DM860T_Y.P1: { class: connector_group; label: "P1: Control" }
DM860T_Y.P1."PUL+": { class: pin }
DM860T_Y.P1."PUL-": { class: pin }
DM860T_Y.P1."DIR+": { class: pin }
DM860T_Y.P1."DIR-": { class: pin }
DM860T_Y.P1."ENA+": { class: pin }
DM860T_Y.P1."ENA-": { class: pin }

DM860T_Y.P2: { class: connector_group; label: "P2: Fault Output" }
DM860T_Y.P2."BRK+": { class: pin }
DM860T_Y.P2."BRK-": { class: pin }
DM860T_Y.P2."ALM+": { class: pin }
DM860T_Y.P2."ALM-": { class: pin }

DM860T_Y.P3: { class: connector_group; label: "P3: Power/Motor" }
DM860T_Y.P3."A+": { class: pin }
DM860T_Y.P3."A-": { class: pin }
DM860T_Y.P3."B+": { class: pin }
DM860T_Y.P3."B-": { class: pin }
DM860T_Y.P3."AC1": { class: pin }
DM860T_Y.P3."AC2": { class: pin }

# --- LASER PSU ---
Laser_PSU: { class: complex_device; label: "Laser PSU" }
Laser_PSU.Terminals: { class: connector_group }
Laser_PSU.Terminals.GND: { class: pin }
Laser_PSU.Terminals.TL: { class: pin }
Laser_PSU.Terminals.IN: { class: pin }
Laser_PSU.Terminals.WP: { class: pin }
Laser_PSU.Terminals.TH: { class: pin }
Laser_PSU.Terminals.V5: { class: pin; label: "5V" }

# --- MOTOREN ---
Stepper_X: { class: end_device; label: "X-Stepper: ST4118M1206-A" }
Stepper_X."A+": { class: pin }; Stepper_X."A-": { class: pin }
Stepper_X."B+": { class: pin }; Stepper_X."B-": { class: pin }

Stepper_Y: { class: end_device; label: "Y-Stepper: PKP266D28A2" }
Stepper_Y."A+": { class: pin }; Stepper_Y."A-": { class: pin }
Stepper_Y."B+": { class: pin }; Stepper_Y."B-": { class: pin }

# --- NETZTEILE und Power Distribution---

# --- GLOBALER STROMANSCHLUSS ---
Global_Plug.class: end_device
Global_Plug.label: "Netzanschluss (AC)"
Global_Plug.Terminals.class: connector_group
Global_Plug.Terminals.L1.class: pin
Global_Plug.Terminals.L2.class: pin
Global_Plug.Terminals.N.class: pin

# --- SCHLÜSSELSCHALTER ---
Key_Switch.class: end_device
Key_Switch.label: "Schlüsselschalter"
Key_Switch.Terminals.class: connector_group
Key_Switch.Terminals.IN1.class: pin
Key_Switch.Terminals.IN2.class: pin
Key_Switch.Terminals.OUT1.class: pin
Key_Switch.Terminals.OUT2.class: pin

# --- LV RELAIS ---
LV_Relais.class: end_device
LV_Relais.label: "LV Relais"
LV_Relais.Terminals.class: connector_group
LV_Relais.Terminals.COM.class: pin
LV_Relais.Terminals.NO.class: pin
LV_Relais.Terminals.COIL1.class: pin
LV_Relais.Terminals.COIL2.class: pin

# --- DURCHFLUSS RELAIS ---
Flow_Relais.class: end_device
Flow_Relais.label: "Durchfluss Relais"
Flow_Relais.Terminals.class: connector_group
Flow_Relais.Terminals.COM1.class: pin
Flow_Relais.Terminals.NO1.class: pin
Flow_Relais.Terminals.COM2.class: pin
Flow_Relais.Terminals.NO2.class: pin
Flow_Relais.Terminals.COIL1.class: pin
Flow_Relais.Terminals.COIL2.class: pin

# --- EIN/AUSSCHALTER ---
Power_Switch.class: end_device
Power_Switch.label: "Ein-/Ausschalter"
Power_Switch.Terminals.class: connector_group
Power_Switch.Terminals.IN.class: pin
Power_Switch.Terminals.OUT.class: pin
Power_Switch.Terminals.N_IN.class: pin
Power_Switch.Terminals.N_OUT.class: pin

# --- 48V Supply ---
PSU_48V.class: end_device
PSU_48V.label: "Netzteil 48V"
PSU_48V.Terminals.class: connector_group
PSU_48V.Terminals.L.class: pin
PSU_48V.Terminals.N.class: pin
PSU_48V.Terminals."+48V".class: pin
PSU_48V.Terminals."0V".class: pin

# --- 24V Supply ---
PSU_24V.class: end_device
PSU_24V.label: "Netzteil 24V"
PSU_24V.Terminals.class: connector_group
PSU_24V.Terminals.L.class: pin
PSU_24V.Terminals.N.class: pin
PSU_24V.Terminals."24V".class: pin
PSU_24V.Terminals."0V".class: pin

# --- VERBINDUNGEN ---

# X-Axis wiring
Ruida_644.AXISX."3: +5V_X" -> DM860T_X.P1."PUL+": "5V Com" {class: kabel_standard}
Ruida_644.AXISX."3: +5V_X" -> DM860T_X.P1."DIR+": "5V Com" {class: kabel_standard}
Ruida_644.AXISX."2: PUL_X" -> DM860T_X.P1."PUL-": "Pulse" {class: kabel_standard}
Ruida_644.AXISX."1: DIR_X" -> DM860T_X.P1."DIR-": "Dir" {class: kabel_standard}

DM860T_X.P3."A+" -> Stepper_X."A+" {class: kabel_standard}
DM860T_X.P3."A-" -> Stepper_X."A-" {class: kabel_standard}
DM860T_X.P3."B+" -> Stepper_X."B+" {class: kabel_standard}
DM860T_X.P3."B-" -> Stepper_X."B-" {class: kabel_standard}

# Y-Axis wiring
Ruida_644.AXISY."3: +5V_Y" -> DM860T_Y.P1."PUL+": "5V Com" {class: kabel_standard}
Ruida_644.AXISY."3: +5V_Y" -> DM860T_Y.P1."DIR+": "5V Com" {class: kabel_standard}
Ruida_644.AXISY."2: PUL_Y" -> DM860T_Y.P1."PUL-": "Pulse" {class: kabel_standard}
Ruida_644.AXISY."1: DIR_Y" -> DM860T_Y.P1."DIR-": "Dir" {class: kabel_standard}

DM860T_Y.P3."A+" -> Stepper_Y."A+" {class: kabel_standard}
DM860T_Y.P3."A-" -> Stepper_Y."A-" {class: kabel_standard}
DM860T_Y.P3."B+" -> Stepper_Y."B+" {class: kabel_standard}
DM860T_Y.P3."B-" -> Stepper_Y."B-" {class: kabel_standard}

# Laser wiring
Ruida_644.CN5.GND -> Laser_PSU.Terminals.GND: "GND" {class: kabel_standard}
Ruida_644.CN5.LON1 -> Laser_PSU.Terminals.TL: "Fire" {class: kabel_standard}
Ruida_644.CN5.LPWM1 -> Laser_PSU.Terminals.IN: "PWM" {class: kabel_standard}

# --- STROMVERBINDUNGEN ---

# Ruida 24V Versorgung über Port CN1 
PSU_24V.Terminals."24V" -> Ruida_644.CN1."6: +24V": "24V DC" {class: kabel_standard}
PSU_24V.Terminals."0V" -> Ruida_644.CN1."1: GND": "GND" {class: kabel_standard}

# Phase L2 speist den gemeinsamen Kontakt
Global_Plug.Terminals.L2 -> LV_Relais.Terminals.COM: "Phase L2" {class: kabel_standard}

# Der Schließerkontakt (NO) versorgt beide Netzteile
LV_Relais.Terminals.NO -> PSU_48V.Terminals.L: "Switched AC" {class: kabel_standard}
LV_Relais.Terminals.NO -> PSU_24V.Terminals.L: "Switched AC" {class: kabel_standard}

# --- VERBINDUNGEN NEUTRALLEITER ---
Global_Plug.Terminals.N -> PSU_48V.Terminals.N: "Neutral" {class: kabel_standard}
Global_Plug.Terminals.N -> PSU_24V.Terminals.N: "Neutral" {class: kabel_standard}

# Motortreiber 48V Versorgung (X-Achse) [cite: 18, 20]
PSU_48V.Terminals."+48V" -> DM860T_X.P3.AC1 {class: kabel_standard}
PSU_48V.Terminals."0V" -> DM860T_X.P3.AC2 {class: kabel_standard}

# Motortreiber 48V Versorgung (Y-Achse) [cite: 21, 23]
PSU_48V.Terminals."+48V" -> DM860T_Y.P3.AC1 {class: kabel_standard}
PSU_48V.Terminals."0V" -> DM860T_Y.P3.AC2 {class: kabel_standard}

# --- VERBINDUNGEN SCHLÜSSELSCHALTER ---
Global_Plug.Terminals.L1 -> Key_Switch.Terminals.IN1: "Phase L1" {class: kabel_standard}
Global_Plug.Terminals.N -> Key_Switch.Terminals.IN2: "Neutralleiter N" {class: kabel_standard}

# Verbindung COM1 an OUT vom Schlüsselschalter
Key_Switch.Terminals.OUT1 -> Flow_Relais.Terminals.COM1: "Phase L1 geschaltet" {class: kabel_standard}
Key_Switch.Terminals.OUT2 -> Flow_Relais.Terminals.COM2: "Neutralleiter geschaltet" {class: kabel_standard}

# --- VERBINDUNGEN DURCHFLUSS RELAIS ZU EIN/AUSSCHALTER ---

# Phase L1 (Kanal 1)
Flow_Relais.Terminals.NO1 -> Power_Switch.Terminals.IN: "Phase L1 geschaltet" {class: kabel_standard}

# Neutralleiter (Kanal 2)
# Zuerst Verbindung vom Schlüsselschalter zum Durchfluss-Relais
Key_Switch.Terminals.OUT2 -> Flow_Relais.Terminals.COM2: "Neutral geschaltet" {class: kabel_standard}

# Dann vom Durchfluss-Relais zum Ein-/Ausschalter
Flow_Relais.Terminals.NO2 -> Power_Switch.Terminals.N_IN: "Neutral geschaltet" {class: kabel_standard}