vars: {
  d2-config: {
    layout-engine: dagre
    #layout-engine: elk
  }
}

direction: right

# Globaler Hintergrund
style.fill: "#f4f4f9"

# 1. Styles & Klassen
classes: {
  kabel_standard: { style.stroke: "#000000"; style.stroke-width: 3 }
  
  pin: {
    shape: rectangle
    width: 80
    height: 40
    style: { font-size: 14; fill: "#ffffff" }
  }

  connector_group: {
    shape: rectangle
    style: { 
      stroke: "#7f8c8d"
      stroke-width: 1
      stroke-dash: 5 
      fill: transparent 
    }
  }

  core_component: {
    shape: rectangle
    style: { stroke: "#ff0000"; stroke-width: 4; fill: "#fff2f2" }
  }
  
  complex_device: {
    shape: rectangle
    style: { stroke: "#0000ff"; stroke-width: 3; fill: "#f2f7ff" }
  }

  end_device: {
    shape: rectangle
    style: { stroke: "#000000"; stroke-width: 2; fill: "#ffffff" }
  }

  electronic_component: {
    shape: parallelogram
    style: { 
      stroke: "#e67e22"
      stroke-width: 2
      fill: "#fbeee6" 
  }
}
}

# --- RUIDA CONTROLLER ---
Ruida_644: { class: core_component; label: "Ruida RDC644G/S" }

# Port CN1: General Output
Ruida_644.CN1: { class: connector_group; label: "CN1: Output" }
Ruida_644.CN1."1: GND": { class: pin }
Ruida_644.CN1."2: OUT2": { class: pin }
Ruida_644.CN1."3: OUT1": { class: pin }
Ruida_644.CN1."4: STATUS": { class: pin }
Ruida_644.CN1."5: WIND": { class: pin }
Ruida_644.CN1."6: +24V": { class: pin }

# Port CN2: General Input
Ruida_644.CN2: { class: connector_group; label: "CN2: Input" }
Ruida_644.CN2."1: GND": { class: pin }
Ruida_644.CN2."2: FOOTSW": { class: pin }
Ruida_644.CN2."3: DRPROC": { class: pin }
Ruida_644.CN2."4: SHOT": { class: pin }
Ruida_644.CN2."5: IN1": { class: pin }
Ruida_644.CN2."6: +24V": { class: pin }

# Port CN3: Limit U/Z
Ruida_644.CN3: { class: connector_group; label: "CN3: Limits U/Z" }
Ruida_644.CN3."1: GND": { class: pin }
Ruida_644.CN3."2: LMTU-": { class: pin }
Ruida_644.CN3."3: LMTU+": { class: pin }
Ruida_644.CN3."4: LMTZ-": { class: pin }
Ruida_644.CN3."5: LMTZ+": { class: pin }
Ruida_644.CN3."6: +5V": { class: pin }

# Port CN4: Limit X/Y
Ruida_644.CN4: { class: connector_group; label: "CN4: Limits X/Y" }
Ruida_644.CN4."1: GND": { class: pin }
Ruida_644.CN4."2: LMTY-": { class: pin }
Ruida_644.CN4."3: LMTY+": { class: pin }
Ruida_644.CN4."4: LMTX-": { class: pin }
Ruida_644.CN4."5: LMTX+": { class: pin }
Ruida_644.CN4."6: +5V": { class: pin }

# Achsen-Schnittstellen (X, Y, Z, U)
Ruida_644.AXISX: { class: connector_group; label: "AXIS X" }
Ruida_644.AXISX."1: DIR_X": { class: pin }
Ruida_644.AXISX."2: PUL_X": { class: pin }
Ruida_644.AXISX."3: +5V_X": { class: pin }

Ruida_644.AXISY: { class: connector_group; label: "AXIS Y" }
Ruida_644.AXISY."1: DIR_Y": { class: pin }
Ruida_644.AXISY."2: PUL_Y": { class: pin }
Ruida_644.AXISY."3: +5V_Y": { class: pin }

Ruida_644.AXISZ: { class: connector_group; label: "AXIS Z" }
Ruida_644.AXISZ."1: DIR_Z": { class: pin }
Ruida_644.AXISZ."2: PUL_Z": { class: pin }
Ruida_644.AXISZ."3: +5V_Z": { class: pin }

Ruida_644.AXISU: { class: connector_group; label: "AXIS U" }
Ruida_644.AXISU."1: DIR_U": { class: pin }
Ruida_644.AXISU."2: PUL_U": { class: pin }
Ruida_644.AXISU."3: +5V_U": { class: pin }

# Laser-Steuerung CN5/CN6
Ruida_644.CN5: { class: connector_group; label: "CN5: Laser 1" }
Ruida_644.CN5."1: GND": { class: pin }
Ruida_644.CN5."2: L-ON1": { class: pin }
Ruida_644.CN5."3: LPWM1": { class: pin }
Ruida_644.CN5."4: WP1": { class: pin }
Ruida_644.CN5."5: L-AN1": { class: pin }

Ruida_644.CN6: { class: connector_group; label: "CN6: Laser 2" }
Ruida_644.CN6."1: GND": { class: pin }
Ruida_644.CN6."2: L-ON2": { class: pin }
Ruida_644.CN6."3: LPWM2": { class: pin }
Ruida_644.CN6."4: WP2": { class: pin }
Ruida_644.CN6."5: L-AN2": { class: pin }

# --- PULL-DOWN WIDERSTAND ---
WP_10k.class: electronic_component
WP_10k.label: "10k pull down"
WP_10k.A.class: pin
WP_10k.B.class: pin

# --- MOTORTREIBER X ---
DM860T_X: { class: complex_device; label: "DM860T (X)" }
DM860T_X.P1: { class: connector_group; label: "P1: Control" }
DM860T_X.P1."PUL+": { class: pin }
DM860T_X.P1."PUL-": { class: pin }
DM860T_X.P1."DIR+": { class: pin }
DM860T_X.P1."DIR-": { class: pin }
DM860T_X.P1."ENA+": { class: pin }
DM860T_X.P1."ENA-": { class: pin }

DM860T_X.P2: { class: connector_group; label: "P2: Fault Output" }
DM860T_X.P2."BRK+": { class: pin }
DM860T_X.P2."BRK-": { class: pin }
DM860T_X.P2."ALM+": { class: pin }
DM860T_X.P2."ALM-": { class: pin }

DM860T_X.P3: { class: connector_group; label: "P3: Power/Motor" }
DM860T_X.P3."A+": { class: pin }
DM860T_X.P3."A-": { class: pin }
DM860T_X.P3."B+": { class: pin }
DM860T_X.P3."B-": { class: pin }
DM860T_X.P3."AC1": { class: pin }
DM860T_X.P3."AC2": { class: pin }

# --- MOTORTREIBER Y ---
DM860T_Y: { class: complex_device; label: "DM860T (Y)" }
DM860T_Y.P1: { class: connector_group; label: "P1: Control" }
DM860T_Y.P1."PUL+": { class: pin }
DM860T_Y.P1."PUL-": { class: pin }
DM860T_Y.P1."DIR+": { class: pin }
DM860T_Y.P1."DIR-": { class: pin }
DM860T_Y.P1."ENA+": { class: pin }
DM860T_Y.P1."ENA-": { class: pin }

DM860T_Y.P2: { class: connector_group; label: "P2: Fault Output" }
DM860T_Y.P2."BRK+": { class: pin }
DM860T_Y.P2."BRK-": { class: pin }
DM860T_Y.P2."ALM+": { class: pin }
DM860T_Y.P2."ALM-": { class: pin }

DM860T_Y.P3: { class: connector_group; label: "P3: Power/Motor" }
DM860T_Y.P3."A+": { class: pin }
DM860T_Y.P3."A-": { class: pin }
DM860T_Y.P3."B+": { class: pin }
DM860T_Y.P3."B-": { class: pin }
DM860T_Y.P3."AC1": { class: pin }
DM860T_Y.P3."AC2": { class: pin }

# --- LASER PSU ---
Laser_PSU: { class: complex_device; label: "Laser PSU" }
Laser_PSU.Terminals: { class: connector_group }
Laser_PSU.Terminals.GND: { class: pin }
Laser_PSU.Terminals.TL: { class: pin }
Laser_PSU.Terminals.IN: { class: pin }
Laser_PSU.Terminals.WP: { class: pin }
Laser_PSU.Terminals.TH: { class: pin }
Laser_PSU.Terminals.V5: { class: pin; label: "5V" }
Laser_PSU.Terminals.AC1.class: pin
Laser_PSU.Terminals.AC2.class: pin

# --- PULL-UP WIDERSTAND (LASER WP) ---
Laser_Pullup_10k.class: electronic_component
Laser_Pullup_10k.label: "10k pull up"
Laser_Pullup_10k.A.class: pin
Laser_Pullup_10k.B.class: pin

# --- LASER TH PULL-DOWN ---
Laser_TH_Pulldown_10k.class: electronic_component
Laser_TH_Pulldown_10k.label: "10k pull down (TH)"
Laser_TH_Pulldown_10k.A.class: pin
Laser_TH_Pulldown_10k.B.class: pin

# --- MOTOREN ---
Stepper_X: { class: end_device; label: "X-Stepper: ST4118M1206-A" }
Stepper_X."A+": { class: pin }; Stepper_X."A-": { class: pin }
Stepper_X."B+": { class: pin }; Stepper_X."B-": { class: pin }

Stepper_Y: { class: end_device; label: "Y-Stepper: PKP266D28A2" }
Stepper_Y."A+": { class: pin }; Stepper_Y."A-": { class: pin }
Stepper_Y."B+": { class: pin }; Stepper_Y."B-": { class: pin }

# --- NETZTEILE und Power Distribution---

# --- SEPARATE STROMVERSORGUNGEN ---
Supply_1.class: end_device
Supply_1.label: "Versorgung Phase 1"
Supply_1.Terminals.class: connector_group
Supply_1.Terminals.L1.class: pin
Supply_1.Terminals.N1.class: pin
Supply_1.Terminals.PE1.class: pin

Supply_2.class: end_device
