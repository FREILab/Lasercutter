vars: {
  d2-config: {
    layout-engine: dagre
    #layout-engine: elk
  }
}

direction: right

# Globaler Hintergrund
style.fill: "#f4f4f9"

# 1. Styles & Klassen für mechanische Komponenten
classes: {
  frame: {
    shape: rectangle
    style: { stroke: "#8B4513"; stroke-width: 3; fill: "#DEB887" }
  }
  
  axis: {
    shape: rectangle
    style: { stroke: "#0000ff"; stroke-width: 2; fill: "#e6f3ff" }
  }

  motor: {
    shape: circle
    style: { stroke: "#ff0000"; stroke-width: 2; fill: "#ffe6e6" }
  }

  laser_head: {
    shape: hexagon
    style: { stroke: "#00ff00"; stroke-width: 3; fill: "#e6ffe6" }
  }

  sensor: {
    shape: diamond
    style: { stroke: "#ffa500"; stroke-width: 2; fill: "#fff2cc" }
  }

  mechanical_component: {
    shape: rectangle
    style: { stroke: "#000000"; stroke-width: 2; fill: "#ffffff" }
  }

  subsystem: {
    shape: rectangle
    style: { 
      stroke: "#7f8c8d"
      stroke-width: 2
      stroke-dash: 3 
      fill: "#f8f9fa" 
    }
  }

  laser_component: {
    shape: oval
    style: { stroke: "#ff4500"; stroke-width: 3; fill: "#ffe4b5" }
  }

  compartment: {
    shape: rectangle
    style: { 
      stroke: "#daa520"
      stroke-width: 2
      stroke-dash: 4 
      fill: "#f5f5dc" 
    }
  }

  # Verbindungs-Klassen für verschiedene Leitungstypen
  luft_leitung: { style.stroke: "#00ffff"; style.stroke-width: 3; style.stroke-dash: 5 }
  strom_230v: { style.stroke: "#ff0000"; style.stroke-width: 4 }
  control_signal: { style.stroke: "#0000ff"; style.stroke-width: 2; style.stroke-dash: 2 }
  optischer_pfad: { style.stroke: "#ff1493"; style.stroke-width: 3; style.stroke-dash: 2 }
}

# Hauptstruktur - Laser Cutter Mechanischer Aufbau
Laser_Cutter: {
  shape: rectangle
  label: "Laser Cutter Gesamtübersicht"

  # Hier werden die Hauptblöcke definiert
  # Beispiel: Rahmen, Achsen, Laser-Kopf usw.
  
  # Rahmen
  Rahmen: {
    class: frame
    label: "Rahmen & Basis"
  }

  # X-Achse
  X_Achse: {
    class: axis
    label: "X-Achse"
    
    # Motor für X-Achse
    X_Motor: {
      class: motor
      label: "X-Motor"
    }
  }

  # Y-Achse
  Y_Achse: {
    class: axis
    label: "Y-Achse"
    
    # Motor für Y-Achse
    Y_Motor: {
      class: motor
      label: "Y-Motor"
    }
  }

  # Z-Achse
  Z_Achse: {
    class: axis
    label: "Z-Achse"
    
    # Motor für Z-Achse
    Z_Motor: {
      class: motor
      label: "Z-Motor"
    }
  }

  # Laser-Kopf
  Laser_Kopf: {
    class: laser_head
    label: "Laser-Kopf"
    
    # Unterkomponenten des Laser-Kopfs
    Luft_Auslass: {
      class: mechanical_component
      label: "Luft-Auslass"
    }
    
    Hoehen_Sensor: {
      class: sensor
      label: "Höhen-Sensor"
    }
    
    Main_Linse: {
      class: mechanical_component
      label: "Main Linse"
    }
  }

  # Laser Kompartment
  Laser_Kompartment: {
    class: compartment
    label: "Laser Kompartment"
    
    High_Power_Laser: {
      class: laser_component
      label: "High Power Laser"
    }
    
    Red_Dot_Laser: {
      class: laser_component
      label: "Red Dot Laser"
    }
  }

  # Sensoren
  Sensoren: {
    class: subsystem
    label: "Sensoren"
    
    # Beispiel-Sensoren
    Endschalter_X: {
      class: sensor
      label: "Endschalter X"
    }
    
    Endschalter_Y: {
      class: sensor
      label: "Endschalter Y"
    }
    
    Endschalter_Z: {
      class: sensor
      label: "Endschalter Z"
    }
  }
}

# Verbindungen zwischen Blöcken
