# Verbindung RFID Leser zu PLC
Laser_Cutter.Control_Box.RFID_Leser -> Laser_Cutter.Electrical_Cabinet.PLC: { class: control_signal }
# 24V Versorgung für PLC
Laser_Cutter.Electrical_Cabinet.PSU_24V -> Laser_Cutter.Electrical_Cabinet.PLC: { class: dc_24v }
# Steuerleitung vom Start/Stop Knopf zum On/Off Relais
Laser_Cutter.Control_Box.Start_Stop_Knopf -> Laser_Cutter.Electrical_Cabinet.On_Off_Relais: { class: control_signal }
# Optischer Pfad: Red Dot Laser → Y-Spiegel
Laser_Cutter.Laser_Kompartment.Red_Dot_Laser -> Laser_Cutter.Laser_Kammer.Y_Achse.Y_Spiegel: { class: optischer_pfad }

# Optischer Pfad: Y-Spiegel → X-Spiegel (Red Dot)
Laser_Cutter.Laser_Kammer.Y_Achse.Y_Spiegel -> Laser_Cutter.Laser_Kammer.Y_Achse.X_Kopf.X_Spiegel: { class: optischer_pfad }

# Optischer Pfad: X-Spiegel → Linse (Red Dot)
Laser_Cutter.Laser_Kammer.Y_Achse.X_Kopf.X_Spiegel -> Laser_Cutter.Laser_Kammer.Y_Achse.X_Kopf.Main_Linse: { class: optischer_pfad }
vars: {
  d2-config: {
    layout-engine: dagre
    #layout-engine: elk
  }
}

direction: right

# Globaler Hintergrund
style.fill: "#f4f4f9"

# 1. Styles & Klassen für mechanische Komponenten
classes: {
  frame: {
    shape: rectangle
    style: { stroke: "#8B4513"; stroke-width: 3; fill: "#DEB887" }
  }
  
  axis: {
    shape: rectangle
    style: { stroke: "#0000ff"; stroke-width: 2; fill: "#e6f3ff" }
  }

  motor: {
    shape: circle
    style: { stroke: "#ff0000"; stroke-width: 2; fill: "#ffe6e6" }
  }

  laser_head: {
    shape: hexagon
    style: { stroke: "#00ff00"; stroke-width: 3; fill: "#e6ffe6" }
  }

  sensor: {
    shape: diamond
    style: { stroke: "#ffa500"; stroke-width: 2; fill: "#fff2cc" }
  }

  mechanical_component: {
    shape: rectangle
    style: { stroke: "#000000"; stroke-width: 2; fill: "#ffffff" }
  }
  xkopf_component: {
    shape: rectangle
    style: { stroke: "#000000"; stroke-width: 2; fill: "#87ceeb" }
  }

  electronic_component: {
    shape: parallelogram
    style: { stroke: "#4b0082"; stroke-width: 2; fill: "#e8e9ff" }
  }

  subsystem: {
    shape: rectangle
    style: { 
      stroke: "#7f8c8d"
      stroke-width: 2
      stroke-dash: 3 
      fill: "#f8f9fa" 
    }
  }

  laser_component: {
    shape: oval
    style: { stroke: "#ff4500"; stroke-width: 3; fill: "#ffe4b5" }
  }

  compartment: {
    shape: rectangle
    style: { 
      stroke: "#daa520"
      stroke-width: 2
      stroke-dash: 4 
      fill: "#f5f5dc" 
    }
  }

  cabinet: {
    shape: rectangle
    style: { stroke: "#696969"; stroke-width: 3; fill: "#d3d3d3" }
  }

  room: {
    shape: rectangle
    style: { 
      stroke: "#daa520"
      stroke-width: 2
      stroke-dash: 4 
      fill: "#f5f5dc" 
    }
  }

  # Verbindungs-Klassen für verschiedene Leitungstypen
  luft_leitung: { style.stroke: "#00ffff"; style.stroke-width: 3; style.stroke-dash: 5 }
  strom_230v: { style.stroke: "#ff0000"; style.stroke-width: 4 }
  dc_24v: { style.stroke: "#32cd32"; style.stroke-width: 3 }
  dc_48v: { style.stroke: "#006400"; style.stroke-width: 3; style.stroke-dash: 2 }
  control_signal: { style.stroke: "#0000ff"; style.stroke-width: 2; style.stroke-dash: 2 }
  optischer_pfad: { style.stroke: "#ff1493"; style.stroke-width: 3; style.stroke-dash: 2 }
}

# Hauptstruktur - Laser Cutter Mechanischer Aufbau
Laser_Cutter: {
  shape: rectangle
  label: "Laser Cutter Gesamtübersicht"

  # Hier werden die Hauptblöcke definiert
 

  # Laser Kammer
  Laser_Kammer: {
    class: room
    label: "Laser Kammer"

      # Y-Endstop in der Laser Kammer
      Y_Endstop: {
        class: sensor
        label: "Y-Endstop"
      }

    Y_Achse: {
      class: axis
      label: "bewegliche Y-Achse"
        # X-Motor ist auf der Y-Achse montiert
        X_Motor: {
          class: motor
          label: "X-Motor"
        }
        # Beweglicher X-Kopf auf der Y-Achse
        X_Kopf: {
          class: xkopf_component
          label: "beweglicher X-Kopf"
          Main_Linse: {
            class: mechanical_component
            label: "Linse"
          }
            X_Spiegel: {
              class: mechanical_component
              label: "X-Spiegel"
            }
        }
          # X-Schleppkette auf der Y-Achse
          X_Schleppkette: {
            class: mechanical_component
            label: "X-Schleppkette"
          }
          # X-Endschalter auf der Y-Achse
          X_Endschalter: {
            class: sensor
            label: "X-Endschalter"
          }
          # Y-Spiegel auf der Y-Achse
          Y_Spiegel: {
            class: mechanical_component
            label: "Y-Spiegel"
          }
    }

    Y_Schleppkette: {
      class: mechanical_component
      label: "Y-Schleppkette"
    }

    Y_Motor: {
      class: motor
      label: "Y-Motor"
    }
  }


  # Laser Kompartment
  Laser_Kompartment: {
    class: room
    label: "Laser Kompartment"
    
    High_Power_Laser: {
      class: laser_component
      label: "High Power Laser"
    }
    
    Red_Dot_Laser: {
      class: laser_component
      label: "Red Dot Laser"
    }
  }

  # Electrical Cabinet
  Electrical_Cabinet: {
    class: room
    label: "Electrical Cabinet"
    
    PSU_24V: {
      class: electronic_component
      label: "24V Netzteil"
    }

    PSU_48V: {
      class: electronic_component
      label: "48V Netzteil"
    }

    Laser_PSU: {
      class: electronic_component
      label: "Laser PSU"
    }

    Ruida_Controller: {
      class: electronic_component
      label: "Ruida Controller"
    }
    
    Schrittmotor_Treiber_X: {
      class: electronic_component
      label: "Schrittmotor Treiber X"
    }
    
    Schrittmotor_Treiber_Y: {
      class: electronic_component
      label: "Schrittmotor Treiber Y"
    }
    
    Schrittmotor_Treiber_Z: {
      class: electronic_component
      label: "Schrittmotor Treiber Z"
    }
      PLC: {
        class: electronic_component
        label: "PLC"
      }

      # Verbindung RFID Leser zu PLC
      Phase_1: {
        class: electronic_component
        label: "Phase 1"
      }
      On_Off_Relais: {
        class: electronic_component
        label: "On/Off Relais"
      }
      Laser_Sicherheitsschalter: {
        class: electronic_component
        label: "Laser-Sicherheitsschalter"
      }
  }

    # Control Box
    Control_Box: {
      class: room
      label: "Control Box"
      Schluesselschalter: {
        class: electronic_component
        label: "Schlüsselschalter"
      }
      Start_Stop_Knopf: {
        class: electronic_component
        label: "Start/Stop Knopf"
      }
      Estop: {
        class: electronic_component
        label: "Estop"
      }
      RFID_Leser: {
        class: electronic_component
        label: "RFID Leser"
      }
    }

  # Sensoren
  Sensoren: {
    class: subsystem
    label: "Sensoren"
    
    # Beispiel-Sensoren
    Endschalter_X: {
      class: sensor
      label: "Endschalter X"
    }
    
    Endschalter_Y: {
      class: sensor
      label: "Endschalter Y"
    }
    
    Endschalter_Z: {
      class: sensor
      label: "Endschalter Z"
    }
  }
}

# Verbindungen zwischen Blöcken
Laser_Cutter.Electrical_Cabinet.PSU_24V -> Laser_Cutter.Electrical_Cabinet.Ruida_Controller: { class: dc_24v }
Laser_Cutter.Electrical_Cabinet.PSU_48V -> Laser_Cutter.Electrical_Cabinet.Schrittmotor_Treiber_X: { class: dc_48v }
Laser_Cutter.Electrical_Cabinet.PSU_48V -> Laser_Cutter.Electrical_Cabinet.Schrittmotor_Treiber_Y: { class: dc_48v }
Laser_Cutter.Electrical_Cabinet.Ruida_Controller -> Laser_Cutter.Electrical_Cabinet.Laser_PSU: { class: control_signal }
Laser_Cutter.Electrical_Cabinet.Laser_PSU -> Laser_Cutter.Laser_Kompartment.High_Power_Laser: { class: control_signal }
Laser_Cutter.Electrical_Cabinet.Ruida_Controller -> Laser_Cutter.Electrical_Cabinet.Schrittmotor_Treiber_X: { class: control_signal }
Laser_Cutter.Electrical_Cabinet.Ruida_Controller -> Laser_Cutter.Electrical_Cabinet.Schrittmotor_Treiber_Y: { class: control_signal }
Laser_Cutter.Electrical_Cabinet.Ruida_Controller -> Laser_Cutter.Electrical_Cabinet.Schrittmotor_Treiber_Z: { class: control_signal }

# Verbindung Schrittmotortreiber Y zu Y-Motor (hierarchisch korrekt)
Laser_Cutter.Electrical_Cabinet.Schrittmotor_Treiber_Y -> Laser_Cutter.Laser_Kammer.Y_Motor: { class: dc_48v }

# Verbindung Schrittmotortreiber X zu Y-Schleppkette
Laser_Cutter.Electrical_Cabinet.Schrittmotor_Treiber_X -> Laser_Cutter.Laser_Kammer.Y_Schleppkette: { class: dc_48v }

# Verbindung Y-Schleppkette zu X-Motor
Laser_Cutter.Laser_Kammer.Y_Schleppkette -> Laser_Cutter.Laser_Kammer.Y_Achse.X_Motor: { class: dc_48v }

# Verbindung Y-Endstop zu Ruida Controller
Laser_Cutter.Laser_Kammer.Y_Endstop -> Laser_Cutter.Electrical_Cabinet.Ruida_Controller: { class: control_signal }

# Phase 1 Strompfad
Laser_Cutter.Electrical_Cabinet.Phase_1 -> Laser_Cutter.Control_Box.Schluesselschalter: { class: strom_230v }
Laser_Cutter.Control_Box.Schluesselschalter -> Laser_Cutter.Electrical_Cabinet.On_Off_Relais: { class: strom_230v }
Laser_Cutter.Electrical_Cabinet.On_Off_Relais -> Laser_Cutter.Control_Box.Estop: { class: strom_230v }
Laser_Cutter.Control_Box.Estop -> Laser_Cutter.Electrical_Cabinet.Laser_Sicherheitsschalter: { class: strom_230v }
Laser_Cutter.Electrical_Cabinet.Laser_Sicherheitsschalter -> Laser_Cutter.Electrical_Cabinet.Laser_PSU: { class: strom_230v }

# Optischer Pfad: High Power Laser → Y-Spiegel
Laser_Cutter.Laser_Kompartment.High_Power_Laser -> Laser_Cutter.Laser_Kammer.Y_Achse.Y_Spiegel: { class: optischer_pfad }

# Optischer Pfad: Y-Spiegel → X-Spiegel
Laser_Cutter.Laser_Kammer.Y_Achse.Y_Spiegel -> Laser_Cutter.Laser_Kammer.Y_Achse.X_Kopf.X_Spiegel: { class: optischer_pfad }

# Optischer Pfad: X-Spiegel → Linse
Laser_Cutter.Laser_Kammer.Y_Achse.X_Kopf.X_Spiegel -> Laser_Cutter.Laser_Kammer.Y_Achse.X_Kopf.Main_Linse: { class: optischer_pfad }

# Verbindung X-Endschalter (auf Y-Achse) zu Y-Schleppkette
Laser_Cutter.Laser_Kammer.Y_Achse.X_Endschalter -> Laser_Cutter.Laser_Kammer.Y_Schleppkette: { class: control_signal }

# Verbindung Y-Schleppkette zu Ruida Controller
Laser_Cutter.Laser_Kammer.Y_Schleppkette -> Laser_Cutter.Electrical_Cabinet.Ruida_Controller: { class: control_signal }
